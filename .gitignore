# --- Python ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp

# --- Cloudflare Pages / Wrangler local cache ---
.wrangler/

# --- nested repo: the /cultural-scout skill has its OWN .git; never track it
#     here (git add -A would otherwise stage it as a broken gitlink) ---
cultural-scout/

# --- deprecated / scratch ---
*.deprecated

# --- stray permission-test artifact (never track) ---
.__perm_test

# --- scratch preview artifacts from the semantic-range prototype (never track) ---
_semrange_*
_semantic_range_*

# --- image_scraper: downloaded imagery + contact sheets are TEMPORARY ANALYSIS
#     ARTIFACTS (copyright rule, CLAUDE.md) — never commit them. Scrape-output
#     JSONs and logs are local working files, also untracked. The scraper's
#     CODE (run.py, extractor.py, sheets.py, README, tests) IS tracked. ---
image_scraper/.cache/
image_scraper/sheets/
image_scraper/output/
image_scraper/logs/
image_scraper/seen_urls.json
# archived-aside cache/sheets from a prior need's run (e.g. .cache_ch_backup,
# sheets_ch_backup) — same imagery, same copyright rule, never commit
image_scraper/.cache_*/
image_scraper/*_backup/

# NOTE: intentionally TRACKED (not ignored):
#   .emb_cache.npz      — int8 embedding cache; expensive to regenerate
#                         (HF model hosts are firewalled on the build machine)
#   site/*.html         — the deployable build artifact (small, and what ships)
#   *.json, *.md, *.yaml, *.py, *.sh — all source, data, and playbook files
